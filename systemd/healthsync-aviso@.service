[Unit]
Description=Health Sync: aviso por Telegram de que falló %i

[Service]
Type=oneshot
User=healthsync
Group=healthsync
# Para leer el registro de la unidad que falló
SupplementaryGroups=systemd-journal
WorkingDirectory=/opt/healthsync/app
ExecStart=/opt/healthsync/venv/bin/python -m healthsync.telegram fallo %i
# Límites: la Pi tiene 1 GB compartido con otros proyectos (ver docs/recursos.md)
MemoryMax=100M
Nice=10
